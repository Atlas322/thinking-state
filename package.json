{
  "name": "@inai/thinking-state",
  "version": "0.3.7-screens.20",
  "description": "Thinking State — the visible chain of thought: an agent's chat actions as live widgets: company renderer, vault collections, chat widgets, icons and tokens.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./chat": {
      "types": "./lib/types/lib/chat.d.ts",
      "import": "./lib/chat.js"
    },
    "./studio": {
      "types": "./lib/types/lib/studio.d.ts",
      "import": "./lib/studio.js"
    },
