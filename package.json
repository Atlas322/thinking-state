  "files": [
    "lib",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE.affectui",
    "LICENSE.simple-icons"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas322/thinking-state.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "package:library": "node scripts/package-library.mjs",
    "predev": "npm run package:library",
    "prebuild": "npm run package:library",
    "check:copy": "node scripts/check-copy.mjs",
    "chat:html": "node scripts/chat-html.mjs",
    "start": "node server.mjs",
    "build:lib": "node scripts/build-lib.mjs",
    "release:lib": "node scripts/release-lib.mjs",
    "tokens:site": "node scripts/site-css.mjs && node scripts/ts-css.mjs",
    "check:spacing": "node scripts/check-spacing.mjs",
    "check:content": "vitest run src/content.test.tsx",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:release-drift": "node scripts/check-release-drift.mjs",
    "story:frames": "node scripts/story-frames.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "studio:exports": "node scripts/studio-exports.mjs",
    "tokens:figma": "node scripts/figma-variables.mjs",
    "check:motion": "node scripts/check-quality.mjs --motion",
    "check:icons": "node scripts/check-quality.mjs --icons",
    "check:quality": "node scripts/check-quality.mjs --motion --icons",
    "check:layout": "node scripts/check-layout.mjs --overflow",
    "check:typography": "node scripts/check-layout.mjs --typography"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/matter-js": "^0.20.2",
    "matter-js": "^0.20.0",
    "motion": "^14.11.1",
    "serve-handler": "^6.1.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
