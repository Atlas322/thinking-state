      "types": "./lib/types/lib/entries/integration-picker.d.ts",
      "import": "./lib/integration-picker.js"
    },
    "./method-quiz": {
      "types": "./lib/types/lib/entries/method-quiz.d.ts",
      "import": "./lib/method-quiz.js"
